# Copy to .env and adjust.

# SQLite (default) needs no setup. For Postgres:
# DATABASE_URL=postgresql+psycopg://gleaner:gleaner@localhost:5432/gleaner

# Sign-in tokens. Use a long random value in any shared deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Where this backend is reachable. The practice store and the crawler's info page (/bot,
# linked from its User-Agent) are served from here. Match the port you run uvicorn on.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Crawler
# RUN_WORKER=true            # false = run the scheduler separately: python -m app.worker
# MAX_CONCURRENT_RUNS=2
# BROWSER_ENABLED=true       # needs: pip install playwright && playwright install chromium

# AI: a local LLM served by Ollama (https://ollama.com). Install Ollama, then download
# the model once with:  ollama pull qwen2.5:7b-instruct-q4_K_M
# Without it the AI features run in offline demo mode (rule-based), so the app still
# works end to end.
# AI_PROVIDER=auto           # auto | local | demo
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M    # qwen2.5:14b-instruct-q4_K_M is better with 12+ GB of GPU memory
# LOCAL_LLM_CONTEXT=20480
